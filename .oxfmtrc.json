{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "tabWidth": 4,
  "useTabs": false,
  "printWidth": 100,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "dist/",
    "build/",
    ".github/",
    "*.min.js",
    "package-lock.json",
    "CHANGELOG.md"
  ]
}
